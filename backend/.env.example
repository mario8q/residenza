# ── Servidor ──────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de datos ─────────────────────────────────────
# Para desarrollo local con Docker:
DATABASE_URL=postgres://residenza_user:residenza_pass@localhost:5432/residenciaspro

# Componentes individuales (equivalentes al URL anterior)
POSTGRES_USER=residenza_user
POSTGRES_PASSWORD=residenza_pass
POSTGRES_DB=residenciaspro
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Autenticación JWT ─────────────────────────────────
# IMPORTANTE: cambiar en producción por una cadena aleatoria de 64+ caracteres
JWT_SECRET=dev_secret_change_in_production_use_openssl_rand_hex_64
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ── Notificaciones Email (SendGrid) ───────────────────
# Obtener en: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@residenciaspro.co
SENDGRID_FROM_NAME=ResidenciasPro

# ── Almacenamiento (Cloudflare R2 o AWS S3) ───────────
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=residenciaspro-files
STORAGE_REGION=auto

# ── Logs ──────────────────────────────────────────────
LOG_LEVEL=debug

# ── Rate limiting ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── pgAdmin (solo Docker Compose dev) ─────────────────
PGADMIN_EMAIL=admin@residenciaspro.co
PGADMIN_PASSWORD=admin123
